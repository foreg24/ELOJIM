PORT=3000
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contrasena

# JSON completo de la cuenta de servicio de Firebase, en una sola línea.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}

# Opcional: bucket de Firebase Storage donde se guardan las imágenes subidas desde el admin.
# Si no se define, se usa "<project_id>.appspot.com" por defecto. Debes crear el bucket
# en Firebase Console > Storage > Comenzar, antes de subir imágenes nuevas.
FIREBASE_STORAGE_BUCKET=
